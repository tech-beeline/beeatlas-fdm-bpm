<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_datapipeline_branch" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.31.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <bpmn:process id="Process_datapipeline_branch" name="datapipeline-branch-process" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Сохранение архитектуры продукта в ветке main, develop или design. Старт: POST /engine-rest/process-definition/key/Process_datapipeline_branch/start, переменные cmdb, docId, branch. Документ workspace.json пользователь загружает до старта. После каждого POST /api/v1/pipeline-runs процесс опрашивает прогон, пока статус не станет терминальным: completed, failed, cancelled, completed_without_publish. Расчёт fitness functions идёт после подтверждения глобального графа.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_1" name="Старт">
      <bpmn:outgoing>Flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start" sourceRef="StartEvent_1" targetRef="Activity_09flps1" />
    <bpmn:serviceTask id="Activity_09flps1" name="Получение информации и регистрации процесса" camunda:asyncBefore="true" camunda:delegateExpression="${RegisterProcessDelegate}">
      <bpmn:documentation>GET /api/v1/product/{code}/info и GET /api/v1/documents/{id}. Файл json, workspace_cmdb совпал с cmdb — статус crt. В processes.context вместе с cmdb и docId сохраняется branch. Ошибка валидации (vldterr, cmdberr, errcrt) завершает шаг исключением.</bpmn:documentation>
      <bpmn:incoming>Flow_start</bpmn:incoming>
      <bpmn:outgoing>Flow_reg_arch</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_reg_arch" sourceRef="Activity_09flps1" targetRef="Activity_stg_arch" />
    <bpmn:serviceTask id="Activity_stg_arch" name="Запуск выгрузки архитектуры, ТВ и технологий" camunda:asyncBefore="true" camunda:delegateExpression="${StartStructurizrArchitectureDelegate}">
      <bpmn:documentation>POST /api/v1/pipeline-runs. artifactType=structurizr-architecture, artifactUid=cmdb, source=manual, branch=переменная branch, payload.docId. Ответ 202: runId пишется в stagingRunId и в processes.context (runId.structurizr-architecture), stagingStatus сбрасывается. Тип в PipelineDefinitions ещё не зарегистрирован.</bpmn:documentation>
      <bpmn:incoming>Flow_reg_arch</bpmn:incoming>
      <bpmn:outgoing>Flow_arch_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_arch_join" sourceRef="Activity_stg_arch" targetRef="Gateway_arch_join" />
    <bpmn:exclusiveGateway id="Gateway_arch_join">
      <bpmn:incoming>Flow_arch_join</bpmn:incoming>
      <bpmn:incoming>Flow_arch_timer_back</bpmn:incoming>
      <bpmn:outgoing>Flow_arch_wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_arch_wait" sourceRef="Gateway_arch_join" targetRef="Activity_stg_arch_wait" />
    <bpmn:serviceTask id="Activity_stg_arch_wait" name="Ожидание завершения пайпа архитектуры" camunda:asyncBefore="true" camunda:delegateExpression="${WaitStagingPipelineDelegate}">
      <bpmn:documentation>GET /api/v1/pipeline-runs/{stagingRunId}/status?waitFor=terminal. Делегат записывает stagingStatus. Пока статус не терминальный, шлюз уводит процесс на таймер и опрос повторяется.</bpmn:documentation>
      <bpmn:incoming>Flow_arch_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_arch_status</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_arch_status" sourceRef="Activity_stg_arch_wait" targetRef="Gateway_stg_arch" />
    <bpmn:exclusiveGateway id="Gateway_stg_arch" name="Пайп архитектуры завершён?" default="Flow_arch_retry">
      <bpmn:incoming>Flow_arch_status</bpmn:incoming>
      <bpmn:outgoing>Flow_arch_fail</bpmn:outgoing>
      <bpmn:outgoing>Flow_arch_ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_arch_retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_arch_fail" name="failed или cancelled" sourceRef="Gateway_stg_arch" targetRef="Gateway_1fpwxbd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${stagingStatus == 'failed' || stagingStatus == 'cancelled'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_arch_ok" name="completed" sourceRef="Gateway_stg_arch" targetRef="Activity_stg_seq">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${stagingStatus == 'completed' || stagingStatus == 'completed_without_publish'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_arch_retry" sourceRef="Gateway_stg_arch" targetRef="Event_stg_arch_timer" />
    <bpmn:intermediateCatchEvent id="Event_stg_arch_timer" name="Повтор через 1 мин">
      <bpmn:incoming>Flow_arch_retry</bpmn:incoming>
      <bpmn:outgoing>Flow_arch_timer_back</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_arch">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_arch_timer_back" sourceRef="Event_stg_arch_timer" targetRef="Gateway_arch_join" />
    <bpmn:serviceTask id="Activity_stg_seq" name="Запуск выгрузки dynamic view" camunda:asyncBefore="true" camunda:delegateExpression="${StartStructurizrSequenceDelegate}">
      <bpmn:documentation>POST /api/v1/pipeline-runs. artifactType=structurizr-sequence, artifactUid=cmdb, source=manual, branch=переменная branch, payload.docId. Ответ 202: новый runId пишется в stagingRunId и в processes.context (runId.structurizr-sequence), stagingStatus сбрасывается. Прогон сам останавливается в awaiting_review, пока пользователь не вызовет apply или decline. Оба решения доводят прогон до терминального статуса, и цикл ожидания тогда отпускает процесс.</bpmn:documentation>
      <bpmn:incoming>Flow_arch_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_seq_join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_seq_join" sourceRef="Activity_stg_seq" targetRef="Gateway_seq_join" />
    <bpmn:exclusiveGateway id="Gateway_seq_join">
      <bpmn:incoming>Flow_seq_join</bpmn:incoming>
      <bpmn:incoming>Flow_seq_timer_back</bpmn:incoming>
      <bpmn:outgoing>Flow_seq_wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_seq_wait" sourceRef="Gateway_seq_join" targetRef="Activity_stg_seq_wait" />
    <bpmn:serviceTask id="Activity_stg_seq_wait" name="Ожидание завершения пайпа dynamic view" camunda:asyncBefore="true" camunda:delegateExpression="${WaitStagingPipelineDelegate}">
      <bpmn:documentation>GET /api/v1/pipeline-runs/{stagingRunId}/status?waitFor=terminal. Пока прогон в awaiting_review или другом нетерминальном статусе, шлюз возвращает процесс на таймер. apply даёт completed, decline даёт completed_without_publish. failed и cancelled завершают data-pipe.</bpmn:documentation>
      <bpmn:incoming>Flow_seq_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_seq_status</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_seq_status" sourceRef="Activity_stg_seq_wait" targetRef="Gateway_stg_seq" />
    <bpmn:exclusiveGateway id="Gateway_stg_seq" name="Пайп dynamic view завершён?" default="Flow_seq_retry">
      <bpmn:incoming>Flow_seq_status</bpmn:incoming>
      <bpmn:outgoing>Flow_seq_fail</bpmn:outgoing>
      <bpmn:outgoing>Flow_seq_ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_seq_retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_seq_fail" name="failed или cancelled" sourceRef="Gateway_stg_seq" targetRef="Gateway_1fpwxbd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${stagingStatus == 'failed' || stagingStatus == 'cancelled'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_seq_ok" name="completed или completed_without_publish" sourceRef="Gateway_stg_seq" targetRef="Activity_1de4p94">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${stagingStatus == 'completed' || stagingStatus == 'completed_without_publish'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_seq_retry" sourceRef="Gateway_stg_seq" targetRef="Event_stg_seq_timer" />
    <bpmn:intermediateCatchEvent id="Event_stg_seq_timer" name="Повтор через 1 мин">
      <bpmn:incoming>Flow_seq_retry</bpmn:incoming>
      <bpmn:outgoing>Flow_seq_timer_back</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_seq">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_seq_timer_back" sourceRef="Event_stg_seq_timer" targetRef="Gateway_seq_join" />
    <bpmn:serviceTask id="Activity_1de4p94" name="Обогащение глобального графа" camunda:asyncBefore="true" camunda:delegateExpression="${GlobalGraphEnrichmentDelegate}">
      <bpmn:documentation>Публикация сообщения в RabbitMQ create_global_graph (taskKey, docId, branch). branch — переменная процесса после trim, регистр без изменений.</bpmn:documentation>
      <bpmn:incoming>Flow_seq_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_1x9gju1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1x9gju1" sourceRef="Activity_1de4p94" targetRef="Gateway_0v2yecb" />
    <bpmn:exclusiveGateway id="Gateway_0v2yecb">
      <bpmn:incoming>Flow_1x9gju1</bpmn:incoming>
      <bpmn:incoming>Flow_1uxg6x8</bpmn:incoming>
      <bpmn:outgoing>Flow_05j455y</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_05j455y" sourceRef="Gateway_0v2yecb" targetRef="Activity_1v1mrsj" />
    <bpmn:serviceTask id="Activity_1v1mrsj" name="Проверка готовности глобального графа" camunda:asyncBefore="true" camunda:delegateExpression="${GlobalGraphCheckDelegate}">
      <bpmn:documentation>GET /api/v1/graph/global/task/{task-id}. Повтор при PROCESS или QUEUE.</bpmn:documentation>
      <bpmn:incoming>Flow_05j455y</bpmn:incoming>
      <bpmn:outgoing>Flow_0m2bqov</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0m2bqov" sourceRef="Activity_1v1mrsj" targetRef="Gateway_1we72aq" />
    <bpmn:exclusiveGateway id="Gateway_1we72aq" default="Flow_0xn5jmm">
      <bpmn:incoming>Flow_0m2bqov</bpmn:incoming>
      <bpmn:outgoing>Flow_00qu8qn</bpmn:outgoing>
      <bpmn:outgoing>Flow_0xn5jmm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_00qu8qn" name="Готов" sourceRef="Gateway_1we72aq" targetRef="Gateway_10n5vqm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.hasVariable('doneGlobalGraph')}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0xn5jmm" sourceRef="Gateway_1we72aq" targetRef="Gateway_11yffam" />
    <bpmn:eventBasedGateway id="Gateway_11yffam">
      <bpmn:incoming>Flow_0xn5jmm</bpmn:incoming>
      <bpmn:outgoing>Flow_19m38ce</bpmn:outgoing>
      <bpmn:outgoing>Flow_15bkt95</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_19m38ce" sourceRef="Gateway_11yffam" targetRef="Event_0iz9uh9" />
    <bpmn:sequenceFlow id="Flow_15bkt95" sourceRef="Gateway_11yffam" targetRef="Event_0rz7wds" />
    <bpmn:intermediateCatchEvent id="Event_0iz9uh9" name="Таймер 5 мин">
      <bpmn:incoming>Flow_19m38ce</bpmn:incoming>
      <bpmn:outgoing>Flow_1uxg6x8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_16opn6q">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_0rz7wds" name="Граф собран">
      <bpmn:incoming>Flow_15bkt95</bpmn:incoming>
      <bpmn:outgoing>Flow_08tuor8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_11t56k3" messageRef="Message_0uib7oi" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_1uxg6x8" sourceRef="Event_0iz9uh9" targetRef="Gateway_0v2yecb" />
    <bpmn:sequenceFlow id="Flow_08tuor8" sourceRef="Event_0rz7wds" targetRef="Activity_0k42n7x" />
    <bpmn:serviceTask id="Activity_0k42n7x" name="Проверка результата глобального графа" camunda:delegateExpression="${GlobalGraphCheckResultDelegate}">
      <bpmn:documentation>Валидация doneGlobalGraph. Ошибка — статус errglblgrph.</bpmn:documentation>
      <bpmn:incoming>Flow_08tuor8</bpmn:incoming>
      <bpmn:outgoing>Flow_1xv42bh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1xv42bh" sourceRef="Activity_0k42n7x" targetRef="Gateway_10n5vqm" />
    <bpmn:exclusiveGateway id="Gateway_10n5vqm">
      <bpmn:incoming>Flow_00qu8qn</bpmn:incoming>
      <bpmn:incoming>Flow_1xv42bh</bpmn:incoming>
      <bpmn:outgoing>Flow_global_ff</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_global_ff" sourceRef="Gateway_10n5vqm" targetRef="Activity_0boo1ka" />
    <bpmn:serviceTask id="Activity_0boo1ka" name="Расчет FF" camunda:asyncBefore="true" camunda:delegateExpression="${CalculateLocalFFDelegate}">
      <bpmn:documentation>POST /api/v1/run-all, docId, source_type=pipeline, source_id=process_id. Шаг стоит после подтверждения глобального графа. Дальше назначение НФТ и проверка паттернов.</bpmn:documentation>
      <bpmn:incoming>Flow_global_ff</bpmn:incoming>
      <bpmn:outgoing>Flow_09aeu24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_09aeu24" sourceRef="Activity_0boo1ka" targetRef="Activity_1viu36t" />
    <bpmn:serviceTask id="Activity_1viu36t" name="Назначение требований на продукт" camunda:asyncBefore="true" camunda:delegateExpression="${AssignProductNfrDelegate}">
      <bpmn:documentation>Та же логика, что в Process_08wprkp. GET /api/v1/nfr, актуальные результаты FF, POST /api/v1/nfr/product?alias={cmdb}. Ветка не участвует.</bpmn:documentation>
      <bpmn:incoming>Flow_09aeu24</bpmn:incoming>
      <bpmn:outgoing>Flow_nfr_pat</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_nfr_pat" sourceRef="Activity_1viu36t" targetRef="Activity_0qj1hi7" />
    <bpmn:serviceTask id="Activity_0qj1hi7" name="Проверка паттернов" camunda:delegateExpression="${CheckPatternsDelegate}">
      <bpmn:documentation>Новый метод проверки паттернов по ветке процесса. Кандидаты: GET /api/v1/pattern/product?alias={cmdb}&amp;branch={branch}. Запись: POST /api/v2/product/{cmdb}/patterns/pipeline?branch={branch}&amp;source-id={docId}. Правило в граф как сейчас, с подстановкой {cmdb}.</bpmn:documentation>
      <bpmn:incoming>Flow_nfr_pat</bpmn:incoming>
      <bpmn:outgoing>Flow_pat_sparx</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_pat_sparx" sourceRef="Activity_0qj1hi7" targetRef="Activity_sparx" />
    <bpmn:serviceTask id="Activity_sparx" name="Выгрузка в Sparx" camunda:asyncBefore="true" camunda:delegateExpression="${PublicToSparxDelegate}">
      <bpmn:documentation>Выгрузка архитектуры продукта в ветку branch. Отдельного метода ещё нет.</bpmn:documentation>
      <bpmn:incoming>Flow_pat_sparx</bpmn:incoming>
      <bpmn:outgoing>Flow_sparx_kts</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_sparx_kts" sourceRef="Activity_sparx" targetRef="Activity_1kts0gen" />
    <bpmn:serviceTask id="Activity_1kts0gen" name="Генерация паспорта КТС в SmartKTS" camunda:asyncBefore="true" camunda:delegateExpression="${GenerateKtsPassportDelegate}">
      <bpmn:documentation>GET /api/v1/product/{code}/info и POST /generate_by_structirizr_id_with_link при integration.smartkts.enabled. Ошибка ставит статус ktserr и не прерывает процесс.</bpmn:documentation>
      <bpmn:incoming>Flow_sparx_kts</bpmn:incoming>
      <bpmn:outgoing>Flow_kts_obs</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_kts_obs" sourceRef="Activity_1kts0gen" targetRef="Activity_1m50rwf" />
    <bpmn:serviceTask id="Activity_1m50rwf" name="Публикация в платформу наблюдаемости" camunda:asyncBefore="true" camunda:delegateExpression="${PublicToObservabilityPlatformDelegate}">
      <bpmn:documentation>GET /api/v1/product/{code}/info. При app.auth_view_platform=true сначала POST /api/token, затем POST /api/structurizrmodel.</bpmn:documentation>
      <bpmn:incoming>Flow_kts_obs</bpmn:incoming>
      <bpmn:outgoing>Flow_obs_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_obs_end" sourceRef="Activity_1m50rwf" targetRef="Gateway_1fpwxbd" />
    <bpmn:exclusiveGateway id="Gateway_1fpwxbd">
      <bpmn:incoming>Flow_arch_fail</bpmn:incoming>
      <bpmn:incoming>Flow_seq_fail</bpmn:incoming>
      <bpmn:incoming>Flow_obs_end</bpmn:incoming>
      <bpmn:outgoing>Flow_0grs3i1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0grs3i1" sourceRef="Gateway_1fpwxbd" targetRef="Event_13e48ot" />
    <bpmn:endEvent id="Event_13e48ot" name="Завершение">
      <bpmn:incoming>Flow_0grs3i1</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:message id="Message_0uib7oi" name="create_global_graph" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_datapipeline_branch">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="155" y="225" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_09flps1_di" bpmnElement="Activity_09flps1">
        <dc:Bounds x="250" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_stg_arch_di" bpmnElement="Activity_stg_arch">
        <dc:Bounds x="410" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_arch_join_di" bpmnElement="Gateway_arch_join" isMarkerVisible="true">
        <dc:Bounds x="565" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_stg_arch_wait_di" bpmnElement="Activity_stg_arch_wait">
        <dc:Bounds x="670" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_stg_arch_di" bpmnElement="Gateway_stg_arch" isMarkerVisible="true">
        <dc:Bounds x="825" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="806" y="132" width="88" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_stg_arch_timer_di" bpmnElement="Event_stg_arch_timer">
        <dc:Bounds x="832" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="808" y="395" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_stg_seq_di" bpmnElement="Activity_stg_seq">
        <dc:Bounds x="930" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_seq_join_di" bpmnElement="Gateway_seq_join" isMarkerVisible="true">
        <dc:Bounds x="1085" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_stg_seq_wait_di" bpmnElement="Activity_stg_seq_wait">
        <dc:Bounds x="1190" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
